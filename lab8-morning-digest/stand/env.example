# Скопируй в .env и заполни. Файл .env в репозиторий не попадает.

# Токен GitHub. Нужны права на чтение репозитория и создание issue.
# Создаётся в Settings -> Developer settings -> Personal access tokens.
# Для тонкого токена достаточно Contents: Read и Issues: Read and write.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Необязательное: какие группы инструментов GitHub отдавать агенту.
GITHUB_TOOLSETS=repos,issues

# Необязательное: свой ключ шифрования учётных данных n8n.
# N8N_ENCRYPTION_KEY=

# Необязательное: прокси для выхода в интернет, если прямого нет.
#
# Внимание: для контейнера внутри виртуальной машины "хост" это сама
# виртуальная машина, а не хост гипервизора. Если прокси запущен на
# Windows-хосте, адрес гостевого шлюза берётся так:
#     ip route | awk '/default/ {print $3}'
# PROXY_URL=http://172.19.32.1:2080
