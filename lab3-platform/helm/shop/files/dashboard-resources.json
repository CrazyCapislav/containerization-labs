          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (phase) (kube_pod_status_phase{namespace=\"shop\",phase=~\"Running|Pending|Failed\"})",
          "legendFormat": "{{phase}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
