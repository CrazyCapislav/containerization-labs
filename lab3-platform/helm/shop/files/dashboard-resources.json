    {
      "id": 3,
      "type": "timeseries",
      "title": "Троттлинг CPU: доля обрезанных периодов CFS",
      "description": "Самый незаметный отказ: поды Running и Ready, перезапусков нет, а сервис медленный. Линия на 10% это порог алерта ShopCriticalPathThrottled.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "max": 1,
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"shop\",container=~\"api|postgres|batch|worker\"}[5m])) / sum by (container) (rate(container_cpu_cfs_periods_total{namespace=\"shop\",container=~\"api|postgres|batch|worker\"}[5m]))",
          "legendFormat": "{{container}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
