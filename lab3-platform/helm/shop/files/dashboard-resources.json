{
  "uid": "shop-resources",
  "title": "shop: ресурсы и SLA критического пути",
  "description": "Лаба 4. Планирование, QoS, вытеснение и выселение. Панели расположены парами: сверху обещание, в середине причины, снизу ёмкость.",
  "tags": [
    "shop",
    "lab4"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "SLA: p95 оформления заказа",
      "description": "Обещание: 95% заказов быстрее 300 мс. Красная линия это порог SLA, он же порог алерта ShopOrderLatencySLOBreach.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"shop\",path=\"/order\"}[5m])))",
          "legendFormat": "p95 /order",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Доля ошибок на пути заказа",
      "description": "Вторая половина SLA. Важна в паре с первой панелью: нехватка процессора даёт задержку без единой ошибки, и по одной этой панели деградацию не увидеть.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "decimals": 4,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{namespace=\"shop\",path=\"/order\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{namespace=\"shop\",path=\"/order\"}[5m]))",
          "legendFormat": "доля 5xx",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "options": {
